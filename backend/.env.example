APP_ENV=development
# Leave DATABASE_URL unset for a local SQLite file, or use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://crisistwin:change_me@localhost:5432/crisistwin
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
# AI provider: auto = Groq if GROQ_API_KEY is set, otherwise Gemini. Keys stay on the server only.
AI_PROVIDER=auto
GROQ_API_KEY=
# Check current model IDs at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_PER_MINUTE=10
